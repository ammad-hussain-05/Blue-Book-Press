# Copy to .env.local and fill in. Never commit real keys.

# ── Contact form (src/app/api/contact/route.ts) ──────────────────────────
# Email delivery uses Resend (https://resend.com). Create an API key there.
# Without it the form validates but replies "message service is being set up".
RESEND_API_KEY=

# Inbox that receives form submissions.
CONTACT_TO_EMAIL=associatesalman@gmail.com

# Sender address. Resend's test sender (onboarding@resend.dev) can only deliver
# to the email address of your own Resend account. For any other inbox, verify
# your domain in Resend and use e.g. "Blue Book Press <hello@bluebookpress.com>".
CONTACT_FROM_EMAIL="Blue Book Press <onboarding@resend.dev>"
